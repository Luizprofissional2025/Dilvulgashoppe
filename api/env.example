DATABASE_URL=postgres://postgres:senha@localhost:5432/agendazap
REDIS_URL=redis://localhost:6379
JWT_SECRET=troque-isto
# Deixe vazio para o MODO DEMONSTRAÇÃO (nada é enviado de verdade)
WA_TOKEN=
WA_PHONE_ID=
SEND_MODE=wa   # conexão direta via QR code; vazio = API oficial/demonstração
MAX_PER_DAY=15          # limite de envios por dia (proteção contra bloqueio)
ALLOW_REGISTER=true     # depois de criar sua conta, mude para false
